{
  "name": "cheltenham-top-tipster",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/expo-start.cjs",
    "start:offline": "expo start --offline",
    "start:expo": "expo start",
    "android": "node ./scripts/expo-start.cjs start --android",
    "ios": "node ./scripts/expo-start.cjs start --ios",
    "web": "node ./scripts/expo-start.cjs start --web",
    "build:web": "node scripts/write-web-manifest.js && expo export --platform web && node scripts/inject-csp-meta.js && node scripts/spa-github-pages-fallback.js && node scripts/write-web-manifest.js",
    "sync:lms-football": "npx tsx scripts/sync-lms-football.ts",
    "remind:lms-deadlines": "npx tsx scripts/send-lms-deadline-reminders.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "^55.0.9",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "supabase": "^2.113.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.3.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2"
  },
  "private": true
