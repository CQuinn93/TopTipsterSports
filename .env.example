# Copy to .env and fill in. Do not commit .env.

# Required for Expo app (npx expo start) – only EXPO_PUBLIC_* are loaded into the app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# RevenueCat public SDK keys (native IAP). Leave blank → “Coming soon” in the app.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxx

# For scripts (pull-races, LMS sync, etc.) and CI
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Supabase Edge Function secrets (set via `supabase secrets set`, not Expo):
# REVENUECAT_WEBHOOK_AUTH=long-random-shared-secret
# RESEND_API_KEY=re_xxx
# RESET_FROM_EMAIL=noreply@yourdomain.com
# RESET_CODE_PEPPER=long-random-secret   # must match on request-reset-code and confirm-reset-code

# football-data.org token (also GitHub Secret: Football_API)
Football_API=your_football_data_org_token
# Big Balls Sports API (GitHub Secret: BIG_BALLS_API) — F2T player roster sync
BIG_BALLS_API=your_big_balls_api_key
# Optional LMS sync overrides:
# LMS_SEASON=2026/27
# FOOTBALL_DATA_SEASON=2026
# LMS_AUTO_SETTLE=true
